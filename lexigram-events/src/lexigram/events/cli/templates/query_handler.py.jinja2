class {{ query_name }}Handler(QueryHandler[{{ query_name }}Query, {{ query_name }}Result]):
    """Handler for {{ query_name }} queries.
    
    Implements the data fetching logic for {{ query_name }} queries.
    """
    
    def __init__(
        self,
        repository: Any = None,
    ):
        """Initialize the handler.
        
        Args:
            repository: The repository for data access.
        """
        self.repository = repository
    
    async def handle(
        self,
        query: {{ query_name }}Query,
    ) -> {{ query_name }}Result:
        """Handle the {{ query_name }} query.
        
        Args:
            query: The query to execute.
            
        Returns:
            The query results.
        """
        try:
            # Validate query
            await self._validate(query)
            
            # Execute query
            data, total = await self._execute(query)
            
            return {{ query_name }}Result(
                success=True,
                data=data,
                total=total,
                message="Query executed successfully",
            )
            
        except Exception as e:  # noqa: BLE001
            return {{ query_name }}Result(
                success=False,
                error=str(e),
            )
    
    async def _validate(self, query: {{ query_name }}Query) -> None:
