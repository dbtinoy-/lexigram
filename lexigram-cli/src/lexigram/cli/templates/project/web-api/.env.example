# Environment variables for development
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./dev.db

# Application
APP_NAME={{ project_name }}
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Logging
LOG_LEVEL=DEBUG

# Optional: JWT Secret (if using auth)
# JWT_SECRET=your-secret-key-here
