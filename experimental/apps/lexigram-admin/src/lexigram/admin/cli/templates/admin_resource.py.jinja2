"""Admin Resource for {{ model_name }}.

This module defines the admin UI configuration for the {{ model_name }} model,
including table columns, filters, actions, and form configuration.

Usage:
    Add to your admin provider:
        >>> from {{ package_name }}.admin.resources import {{ resource_name }}
        >>> provider.add_resource({{ resource_name }})
"""

from __future__ import annotations

from typing import Any

from lexigram.admin.actions import CreateAction, DeleteAction, EditAction
from lexigram.admin.rbac.schema import ResourcePermissions
from lexigram.admin.resources.base import Resource
from lexigram.admin.schema import BooleanField, DateField, TextField
from lexigram.admin.ui.filters import RangeFilter, ToggleFilter
from lexigram.ui import BooleanColumn, DateColumn, TextColumn


class {{ resource_name }}(Resource):
    """Admin resource for {{ model_name }}.

    Provides:
    - List view with sortable columns
    - Create/Edit form derived from `fields`
    - Filter and search capabilities
    - Row actions support
    """

    # Model: point this at your entity/model class (e.g. AdminUserEntity).
    model = None

    # Registration metadata
    name = "{{ file_name }}"
    label = "{{ label }}"
    icon = "{{ icon }}"
    visible_in_sidebar = {{ visible_in_sidebar }}

    # Declarative schema — columns, filters and forms derive from `fields`.
    fields: list[Any] = [
        {%- for field in fields %}
        {{ field.declaration }},
        {%- endfor %}
    ]

    # Table Columns
    columns = [
        {%- for column in columns %}
        {{ column }},
        {%- endfor %}
    ]

    # Row / header actions
    actions = [
        EditAction(),
        DeleteAction(),
    ]
    header_actions = [
        CreateAction(label="{{ label }}"),
    ]

    # Filters
    filters = [
        {%- for filter_def in filter_fields %}
        {{ filter_def }},
        {%- endfor %}
    ]

    # Form / pagination configuration
    form_display_mode = "{{ form_display_mode }}"
    page_size = {{ page_size }}
    default_sort = "{{ default_sort }}"

    # Permissions
    permissions = ResourcePermissions(
        can_list={"*"},
        can_view={"*"},
        can_create={"{{ permission_prefix }}:create"},
        can_edit={"{{ permission_prefix }}:edit"},
        can_delete={"{{ permission_prefix }}:delete"},
    )

    # Hooks
    async def before_create(self, data: dict) -> dict:
        """Hook called before creating a record."""
        # Add custom validation or data modification
        return data

    async def after_create(self, record: Any) -> None:
        """Hook called after creating a record."""
        # Log the creation, send notifications, etc.
        pass

    async def before_update(self, item_id: Any, data: dict) -> dict:
        """Hook called before updating a record."""
        return data

    async def after_update(self, record: Any) -> None:
        """Hook called after updating a record."""
        pass

    async def before_delete(self, item_id: Any) -> None:
        """Hook called before deleting a record."""
        pass

    async def after_delete(self, item_id: Any) -> None:
        """Hook called after deleting a record."""
        pass


__all__ = ["{{ resource_name }}"]
