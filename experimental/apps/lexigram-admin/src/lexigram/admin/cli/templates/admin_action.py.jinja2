{% if action_type == 'bulk' %}
class {{ action_name }}BulkAction({{ action_name }}Action):
    """Bulk action variant for {{ action_name }}.
    
    Handles multiple records at once.
    """
    
    async def execute(
        self,
        resource: Any,
        records: list[Any],
        context: dict[str, Any],
    ) -> dict[str, Any]:
        """Execute the bulk action.
        
        Args:
            resource: The admin resource.
            records: List of records to act on.
            context: Execution context.
            
        Returns:
            Result dictionary with success status and summary.
        """
        results = []
        
        for record in records:
            result = await self._process_record(record, context)
            results.append(result)
        
        success_count = sum(1 for r in results if r.get("success"))
        
        return {
            "success": True,
            "processed": len(records),
            "succeeded": success_count,
            "failed": len(records) - success_count,
            "message": f"Processed {len(records)} records",
        }
{% endif %}


