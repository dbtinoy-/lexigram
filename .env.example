# Lexigram Framework core environment configuration example.
#
# Copy to .env and adjust values for your deployment:
#   cp .env.example .env
#
# All variables are optional unless noted: every config value carries a
# code default, so an unset variable falls back to framework defaults.
#
# Critical secrets MUST be set in production:
#   * any value shown as <change-me-in-production>
#   * provider API keys (OpenAI, Anthropic, Google, ...) supplied through
#     your secrets manager or LEX_*_SECRET_NAME references

# ── lexigram ──
LEX_DEBUG=false  # — (str)
LEX_LEXIGRAM__APP_NAME=  # Application name (str)
LEX_LEXIGRAM__DEBUG=  # Enable debug mode. Also toggled by the LEX_DEBUG env var. (bool)
LEX_LEXIGRAM__DISCOVERY__AUTO_DISCOVER=  # — (bool)
LEX_LEXIGRAM__DISCOVERY__DIRECTORIES=  # — (list[str])
LEX_LEXIGRAM__DISCOVERY__DISABLED_MODULES=  # — (list[str])
LEX_LEXIGRAM__DISCOVERY__ENABLED_MODULES=  # — (list[str])
LEX_LEXIGRAM__DISCOVERY__ENTRY_POINT_GROUP=  # — (str)
LEX_LEXIGRAM__ENV=  # Deployment environment (development, staging, production, test). (Environment)
LEX_LEXIGRAM__HEALTH__CHECK_TIMEOUT=  # — (float)
LEX_LEXIGRAM__HEALTH__INCLUDE_DETAILS=  # — (bool)
LEX_LEXIGRAM__LOGGING__JSON_FORMAT=  # JSON log format (bool)
LEX_LEXIGRAM__LOGGING__LEVEL=  # Global log level (str)
LEX_LEXIGRAM__LOGGING__LEVELS=  # Per-logger level overrides (dict[str, str])
LEX_LEXIGRAM__LOGGING__REDACTION__ENABLED=  # — (bool)
LEX_LEXIGRAM__LOGGING__REDACTION__FIELD_DENYLIST=  # — (tuple[str, ...])
LEX_LEXIGRAM__LOGGING__SAMPLING__DEFAULT_RATE=  # — (float)
LEX_LEXIGRAM__LOGGING__SAMPLING__ENABLED=  # — (bool)
LEX_LEXIGRAM__LOGGING__SAMPLING__RULES=  # — (dict[str, float])
LEX_LEXIGRAM__MODULES=  # Enabled modules (list[str])
LEX_PROFILE=development  # — (str)
LEX_QUIET=false  # — (str)
LEX_SECURITY__HASHING__ALGORITHM=  # — (str)
LEX_SECURITY__HASHING__BLAKE2B_DIGEST_SIZE=  # — (int)
LEX_SECURITY__HASHING__DEFAULT_HASHER=  # — (str)
LEX_SECURITY__HASHING__DKLEN=  # — (int)
LEX_SECURITY__HASHING__ITERATIONS=  # — (int)
LEX_SECURITY__HASHING__SALT_LENGTH=  # — (int)
LEX_SECURITY__SANITIZATION__ALLOWED_TAGS=  # — (set[str] | None)
LEX_SECURITY__SANITIZATION__DEFAULT_SANITIZE_MODE=  # — (str)
LEX_SECURITY__SANITIZATION__STRIP_COMMENTS=  # — (bool)
