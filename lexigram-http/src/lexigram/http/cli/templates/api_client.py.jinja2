    async def _request(
        self,
        method: str,
        endpoint: str,
        **kwargs: Any,
    ) -> httpx.Response:
        """Make an HTTP request with error handling.
        
        Args:
            method: HTTP method (GET, POST, PUT, PATCH, DELETE).
            endpoint: API endpoint path.
            **kwargs: Additional arguments to pass to httpx.
            
        Returns:
            The HTTP response.
            
        Raises:
            {{ client_name }}APIError: If the API returns an error.
        """
        url = f"{self.base_url}{endpoint}"
        
        try:
            response = await self._client.request(method, url, **kwargs)
            response.raise_for_status()
            return response
            
        except httpx.HTTPStatusError as e:
            logger.error(f"API error: {e.response.status_code} - {e.response.text}")
            raise {{ client_name }}APIError(
                message=f"API request failed: {e.response.status_code}",
                status_code=e.response.status_code,
                response=e.response,
            ) from e
            
        except httpx.RequestError as e:
            logger.error(f"Request error: {e}")
            raise {{ client_name }}APIError(
                message=f"Request failed: {str(e)}",
                status_code=None,
                response=None,
            ) from e


class {{ client_name }}APIError(Exception):
    """Exception raised when the {{ client_name }} API returns an error."""
    
    def __init__(
        self,
        message: str,
        status_code: int | None,
        response: httpx.Response | None,
    ):
        """Initialize the error.
        
        Args:
            message: Error message.
            status_code: HTTP status code.
            response: The response object if available.
        """
        super().__init__(message)
        self.message = message
        self.status_code = status_code
        self.response = response


