    # service = await {{ class_name }}Service()
    # result = await service.process(...)
    
    return {
        "processed": True,
        "count": len(args),
    }


@injectable
class {{ class_name }}TaskRunner:
    """Task runner for {{ class_name }} operations.
    
    This class provides a convenient way to dispatch {{ name }} tasks
    and manage their execution.
    """
    
    def __init__(self):
        """Initialize the task runner."""
        from lexigram.tasks.dispatcher import TaskDispatcher
        
        self.dispatcher = TaskDispatcher()
        self._logger = None
    
    @property
    def logger(self):
        """Get logger."""
        if self._logger is None:
            from lexigram.logging import get_logger
            self._logger = get_logger("{{ class_name }}TaskRunner")
        return self._logger
    
    async def run(
        self,
        {% for param in params %}
        {{ param.name }}: {{ param.type }} = {{ param.default }},
        {% endfor %}
        delay: float = 0,
    ) -> str:
        """Run the {{ name }} task.
        
        Args:
            {% for param in params %}
            {{ param.name }}: {{ param.description or 'The ' + param.name }}
            {% endfor %}
            delay: Optional delay in seconds before running.
            
        Returns:
            Task ID for tracking.
        """
        task_kwargs = {
            {% for param in params %}
            "{{ param.name }}": {{ param.name }},
            {% endfor %}
        }
        
        self.logger.info(f"Dispatching {{ name }} task", extra=task_kwargs)
        
        if delay > 0:
            # Schedule task for later
            task_id = await self.dispatcher.schedule(
                {{ name }},
                delay=delay,
                **task_kwargs,
            )
        else:
            # Run task immediately
            task_id = await self.dispatcher.dispatch(
                {{ name }},
                **task_kwargs,
            )
        
        self.logger.info(f"{{ name }} task dispatched with ID: {task_id}")
        
        return task_id
    
    async def run_periodic(self, interval: float = 60) -> str:
        """Run the {{ name }} task periodically.
        
        Args:
            interval: Interval in seconds between runs.
            
        Returns:
            Task ID for tracking.
        """
        self.logger.info(f"Scheduling {{ name }} task to run every {interval}s")
        
        task_id = await self.dispatcher.schedule_periodic(
            {{ name }},
            interval=interval,
        )
        
        return task_id
