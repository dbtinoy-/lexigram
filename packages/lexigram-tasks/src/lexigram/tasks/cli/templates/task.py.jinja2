from typing import Any

from lexigram.di import injectable
from lexigram.tasks import task, TaskResult, TaskStatus


@task(
    name="{{ resource_name }}",
    description="{{ doc or 'Task for processing ' + resource_name }}",
    {% if schedule %}schedule="{{ schedule }}",{% endif %}
)
async def {{ name }}(
    *args: Any,
    **kwargs: Any,
) -> TaskResult:
    """{{ doc or 'Process ' + resource_name }}.
    
    This is an async background task that can be scheduled or triggered manually.
    
    Args:
        *args: Positional arguments.
        **kwargs: Keyword arguments.
        
    Returns:
        TaskResult with success status and any result data.
    """
    # Import logger inside function to avoid circular imports
    from lexigram.logging import get_logger
    
    logger = get_logger("task.{{ name }}")
    
    logger.info(f"Starting {{ name }} task", extra={"args": args, "kwargs": kwargs})
    
    try:
        # Extract parameters from kwargs
        {% for param in params %}
        {{ param.name }} = kwargs.get("{{ param.name }}", {{ param.default }})
        {% endfor %}
        
        # TODO: Add your task logic here
        # Example:
        # result = await process_{{ resource_name }}({{ name }}={{ name }})
        
        # Process the task
        result_data = await _process_{{ resource_name }}(*args, **kwargs)
        
        logger.info(f"{{ name }} task completed successfully")
        
        return TaskResult(
            status=TaskStatus.SUCCESS,
            message="{{ name }} completed successfully",
            data=result_data,
        )
        
    except Exception as e:  # noqa: BLE001
        logger.exception(f"{{ name }} task failed: {e}")
        
        return TaskResult(
            status=TaskStatus.FAILED,
            message=f"Task failed: {str(e)}",
            error=str(e),
        )


