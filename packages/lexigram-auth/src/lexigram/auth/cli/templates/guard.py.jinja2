{% if guard_type == 'role' %}
class {{ guard_name }}RoleGuard({{ guard_name }}Guard):
    """Role-based guard for {{ guard_name }}.
    
    Checks if the user has one of the required roles.
    """
    
    def __init__(
        self,
        roles: list[str],
        authorization_provider: AuthorizationProvider | None = None,
    ):
        """Initialize the role guard.
        
        Args:
            roles: List of allowed roles.
            authorization_provider: Optional authorization service.
        """
        super().__init__(authorization_provider)
        self.roles = roles
    
    async def _check_{{ guard_name_snake }}(
        self,
        user: Any,
        context: GuardContext,
    ) -> bool:
        """Check if user has required role."""
        if not hasattr(user, "roles"):
            return False
        
        user_roles = user.roles if isinstance(user.roles, list) else []
        return any(role in user_roles for role in self.roles)
{% endif %}


