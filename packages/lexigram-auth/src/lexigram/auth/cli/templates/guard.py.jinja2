{% if guard_type == 'permission' %}
class {{ guard_name }}PermissionGuard({{ guard_name }}Guard):
    """Permission-based guard for {{ guard_name }}.
    
    Checks if the user has one of the required permissions.
    """
    
    def __init__(
        self,
        permissions: list[str],
        authorization_provider: AuthorizationProvider | None = None,
    ):
        """Initialize the permission guard.
        
        Args:
            permissions: List of required permissions.
            authorization_provider: Optional authorization service.
        """
        super().__init__(authorization_provider)
        self.permissions = permissions
    
    async def _check_{{ guard_name_snake }}(
        self,
        user: Any,
        context: GuardContext,
    ) -> bool:
        """Check if user has required permission."""
        if not hasattr(user, "permissions"):
            return False
        
        user_permissions = user.permissions if isinstance(user.permissions, list) else []
        return any(perm in user_permissions for perm in self.permissions)
{% endif %}


