"""{{ guard_name }} authorization guard.

This module provides a custom authorization guard for Lexigram.
"""

from __future__ import annotations

from typing import TYPE_CHECKING, Any

from lexigram.auth.web.guards import Guard, GuardContext

if TYPE_CHECKING:
    from lexigram.auth.providers import AuthorizationProvider


class {{ guard_name }}Guard(Guard):
    """Custom authorization guard for {{ guard_name }}.
    
    This guard checks if the user has the required authorization
    to access a resource or perform an action.
    """
    
    def __init__(
        self,
        authorization_provider: AuthorizationProvider | None = None,
    ):
        """Initialize the guard.
        
        Args:
            authorization_provider: Optional authorization service.
        """
        self.authorization_provider = authorization_provider
    
    async def check(self, context: GuardContext) -> bool:
        """Check if the request is authorized.
        
        Args:
            context: The guard context containing request and user info.
            
        Returns:
            True if authorized, False otherwise.
        """
        # Get user from context
        user = context.user
        
        if user is None:
            return False
        
        # Add your authorization logic here
        # Example for role guard:
        # return await self._check_role(user, context)
        
        # Example for permission guard:
        # return await self._check_permission(user, context)
        
        # Example for custom logic:
        # return await self._check_custom(user, context)
        
        return await self._check_{{ guard_name_snake }}(user, context)
    
    async def _check_{{ guard_name_snake }}(
        self,
        user: Any,
        context: GuardContext,
    ) -> bool:
        """Custom authorization check for {{ guard_name }}.
        
        Args:
            user: The authenticated user.
            context: The guard context.
            
        Returns:
            True if authorized.
        """
        # Implement your custom logic here
        # Example:
        # if not user.is_active:
        #     return False
        #
        # Check specific conditions
        # return user.has_permission("{{ guard_name_snake }}:access")
        
        return True
    
    def get_error_message(self) -> str:
        """Get the error message to show when authorization fails."""
        return "{{ guard_name }} authorization failed. You don't have permission to access this resource."


