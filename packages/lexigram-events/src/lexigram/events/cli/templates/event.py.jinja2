# Convenience function to publish events
async def publish_{{ resource_name }}_event(
    event_bus: EventBus,
    {{ resource_name }}_id: int,
    action: str,
    data: dict[str, Any] | None = None,
) -> {{ class_name }}Event:
    """Publish a {{ resource_name }} event.
    
    Args:
        event_bus: The event bus to publish to.
        {{ resource_name }}_id: The {{ resource_name }} ID.
        action: The action performed.
        data: Optional event data.
        
    Returns:
        The published event.
    """
    event = {{ class_name }}Event(
        id={{ resource_name }}_id,
        action=action,
        data=data or {},
    )
    
    await event_bus.publish(event)
    return event
