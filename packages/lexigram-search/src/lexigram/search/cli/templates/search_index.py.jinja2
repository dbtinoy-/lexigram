class {{ index_name }}SearchService:
    """Search service for {{ index_name }}.

    Provides methods for indexing, searching, and managing {{ index_name }} documents.
    """

    def __init__(self, search_engine: SearchEngine):
        """Initialize the search service.

        Args:
            search_engine: The search engine to use.
        """
        self.search_engine = search_engine
        self.index_name = "{{ index_name_snake }}"

    async def ensure_index(self) -> None:
        """Create the index if it does not exist yet."""
        result = await self.search_engine.index_exists(self.index_name)
        if result.is_err():
            raise result.unwrap_err()
        if result.unwrap():
            return
        created = await self.search_engine.create_index(self.index_name)
        if created.is_err():
            raise created.unwrap_err()

    async def index_document(self, document: {{ index_name }}Document) -> None:
        """Index a single document.

        Args:
            document: The document to index.
        """
        await self.index_documents([document])

    async def index_documents(self, documents: list[{{ index_name }}Document]) -> None:
        """Index multiple documents in batch.

        Args:
            documents: The documents to index.
        """
        result = await self.search_engine.index(
            self.index_name,
            [document.model_dump() for document in documents],
        )
        if result.is_err():
            raise result.unwrap_err()

    async def search(
        self,
        query: str | SearchQuery,
        filters: dict[str, Any] | None = None,
        limit: int = 20,
        offset: int = 0,
    ) -> SearchResponse:
        """Search for documents matching the query.

        Args:
            query: Search query string or SearchQuery object.
            filters: Optional filters to apply.
            limit: Maximum number of results.
            offset: Offset for pagination.

        Returns:
            The search response with matching documents.
        """
        result = await self.search_engine.search(
            self.index_name,
            query if isinstance(query, str) else query.query,
            filters=filters,
            limit=limit,
            offset=offset,
        )
        if result.is_err():
            raise result.unwrap_err()
        return result.unwrap()

    async def get_document(self, document_id: str) -> {{ index_name }}Document | None:
        """Get a document by ID.

        Args:
            document_id: The document ID.

        Returns:
            The document if found, None otherwise.
        """
        result = await self.search_engine.search(
            self.index_name,
            "",
            filters={"id": document_id},
            limit=1,
            offset=0,
        )
        if result.is_err():
            raise result.unwrap_err()
        response = result.unwrap()
        if not response.results:
            return None
        return {{ index_name }}Document(**response.results[0].data)

    async def count(self) -> int:
        """Get the total number of documents in the index.

        Returns:
            Document count.
        """
        result = await self.search_engine.search(
            self.index_name,
            "*",
            limit=0,
            offset=0,
        )
        if result.is_err():
            raise result.unwrap_err()
        return result.unwrap().total

    async def delete_document(self, document_id: str) -> None:
        """Delete a document from the index.

        Args:
            document_id: The document ID to delete.
        """
        result = await self.search_engine.delete(
            self.index_name,
            document_id,
        )
        if result.is_err():
            raise result.unwrap_err()
