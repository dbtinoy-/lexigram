Scaffold: endpoints delegate to ``self.repo`` — wire a repository with
CRUD methods (create/get/list/update/delete) in your DI provider.
"""
from __future__ import annotations

from lexigram.web import Controller, delete, get, post, put
from lexigram.web.exceptions import (
    BadRequestError,
    InternalServerError,
    NotFoundError,
)
from lexigram.web.routing.controllers import Controller

from .repositories.{{ model_name }}_repository import {{ class_name }}Repository


class {{ class_name }}Controller(Controller):
    """Controller for {{ class_name }} CRUD operations."""

    def __init__(self, repo: {{ class_name }}Repository) -> None:
        super().__init__()
        self.repo = repo

    @get("/{{ resource_path }}")
    async def list(
        self,
        limit: int = 20,
        offset: int = 0,
    ) -> dict[str, Any]:
        items = await self.repo.list(limit=limit, offset=offset)
        return {
            "items": [
                item.to_dict() if hasattr(item, "to_dict") else item
                for item in items
            ],
            "limit": limit,
            "offset": offset,
        }

    @get("/{{ resource_path }}/{item_id}")
    async def get(self, item_id: str) -> dict[str, Any]:
        item = await self.repo.get(item_id)
        if item is None:
            raise NotFoundError(
                f"{{ class_name }} not found with id: {item_id}"
            )
        return item.to_dict() if hasattr(item, "to_dict") else item

    @post("/{{ resource_path }}", status_code=201)
    async def create(self, request: Request) -> dict[str, Any]:
        import json as _json

        data = _json.loads(await request.body() or b"{}")
        if not data:
            raise BadRequestError("Request body is required")
        created = await self.repo.create(data)
        return created.to_dict() if hasattr(created, "to_dict") else created

    @put("/{{ resource_path }}/{item_id}")
    async def update(
        self,
        item_id: str,
        request: Request,
    ) -> dict[str, Any]:
        import json as _json

        data = _json.loads(await request.body() or b"{}")
        if not data:
            raise BadRequestError("Request body is required")
        updated = await self.repo.update(item_id, data)
        if updated is None:
            raise NotFoundError(
                f"{{ class_name }} not found with id: {item_id}"
            )
        return updated.to_dict() if hasattr(updated, "to_dict") else updated

    @delete("/{{ resource_path }}/{item_id}")
    async def delete(self, item_id: str) -> dict[str, str]:
        deleted = await self.repo.delete(item_id)
        if not deleted:
            raise NotFoundError(
                f"{{ class_name }} not found with id: {item_id}"
            )
        return {"message": "{{ class_name }} deleted"}
