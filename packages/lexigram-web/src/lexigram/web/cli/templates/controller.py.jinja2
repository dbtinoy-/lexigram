from __future__ import annotations

from typing import Any

from starlette.requests import Request

from lexigram.web import Controller, delete, get, post, put
from lexigram.web.exceptions import (
    BadRequestError,
    NotFoundError,
)

from .repositories.{{ model_name }}_repository import {{ class_name }}Repository


def _to_dict(item: Any) -> dict[str, Any]:
    """Serialize a repo result to a JSON-safe dict."""
    if isinstance(item, dict):
        return item
    if hasattr(item, "to_dict"):
        return item.to_dict()
    if hasattr(item, "__dict__"):
        return dict(vars(item))
    return {"value": item}


class {{ class_name }}Controller(Controller):
    """Controller for {{ class_name }} CRUD operations."""

    def __init__(self, repo: {{ class_name }}Repository) -> None:
        super().__init__()
        self.repo = repo

    @get("/{{ resource_path }}")
    async def list(
        self,
        limit: int = 20,
    ) -> dict[str, Any]:
        items = await self.repo.list(limit=limit)
        return {
            "items": [_to_dict(item) for item in items],
            "limit": limit,
        }

    @get("/{{ resource_path }}/{item_id}")
    async def get(self, item_id: str) -> dict[str, Any]:
        item = await self.repo.get(item_id)
        if item is None:
            raise NotFoundError(
                f"{{ class_name }} not found with id: {item_id}"
            )
        return _to_dict(item)

    @post("/{{ resource_path }}", status_code=201)
    async def create(self, request: Request) -> dict[str, Any]:
        try:
            data: Any = await request.json()
        except Exception as exc:
            raise BadRequestError("Invalid JSON body") from exc
        if not isinstance(data, dict) or not data:
            raise BadRequestError("Request body must be a non-empty JSON object")
        created = await self.repo.create(data)
        return _to_dict(created)

    @put("/{{ resource_path }}/{item_id}")
    async def update(
        self,
        item_id: str,
        request: Request,
    ) -> dict[str, Any]:
        try:
            data: Any = await request.json()
        except Exception as exc:
            raise BadRequestError("Invalid JSON body") from exc
        if not isinstance(data, dict) or not data:
            raise BadRequestError("Request body must be a non-empty JSON object")
        updated = await self.repo.update(item_id, data)
        if updated is None:
            raise NotFoundError(
                f"{{ class_name }} not found with id: {item_id}"
            )
        return _to_dict(updated)

    @delete("/{{ resource_path }}/{item_id}")
    async def delete(self, item_id: str) -> dict[str, str]:
        deleted = await self.repo.delete(item_id)
        if not deleted:
            raise NotFoundError(
                f"{{ class_name }} not found with id: {item_id}"
            )
        return {"message": "{{ class_name }} deleted"}
