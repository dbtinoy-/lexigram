{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source for SLO metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "8.5.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "5.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "SLO Burn Rate",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.0 },
              { "color": "red", "value": 2.0 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "lexigram_slo_burn_rate{slo_name=~\"$slo_name\", tier=~\"$tier\"}",
          "legendFormat": "{{slo_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Burn Rate per SLO",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.0 },
              { "color": "red", "value": 2.0 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "lexigram_slo_latency_p99{slo_name=~\"$slo_name\"}",
          "legendFormat": "p99 {{slo_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "lexigram_slo_threshold{slo_name=~\"$slo_name\"}",
          "legendFormat": "threshold {{slo_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Latency p99 vs Threshold",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "panels": [],
      "title": "Alert Status",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "P0" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#e02b44" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "P1" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#ffa000" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "P2" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#73bf69" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "count(lexigram_slo_burn_rate{tier=\"p0_page\"} > 1.0)",
          "legendFormat": "P0",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "count(lexigram_slo_burn_rate{tier=\"p1_business_hours\"} > 1.0)",
          "legendFormat": "P1",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "count(lexigram_slo_burn_rate{tier=\"p2_digest\"} > 1.0)",
          "legendFormat": "P2",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Active Violations by Tier",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 10 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(lexigram_slo_budget_remaining) / count(lexigram_slo_budget_remaining)",
          "legendFormat": "Avg budget remaining",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Average Error Budget Remaining",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Suppressed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872d" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Dispatched" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#e02b44" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 10 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(lexigram_alerts_dispatched_total[5m]))",
          "legendFormat": "Dispatched",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(lexigram_alerts_suppressed_total[5m]))",
          "legendFormat": "Suppressed",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Alert Dispatch Rate (5m avg)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 8,
      "panels": [],
      "title": "SLO Compliance Table",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Tier" },
            "properties": [
              {
                "id": "displayName",
                "value": "Tier"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Owner" },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Runbook" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-text"
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "id": 9,
      "options": {
        "footer": { "countRows": false, "enablePagination": true, "fields": "", "reducer": ["sum"], "show": false },
        "sortBy": [{ "displayName": "Burn Rate", "desc": true }],
        "style": { "overflow": "auto" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "lexigram_slo_info",
          "format": "table",
          "legendFormat": "{{slo_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "lexigram_slo_burn_rate",
          "format": "table",
          "legendFormat": "{{slo_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "SLO Overview",
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "slo_name": { "aggregations": [], "operation": "groupby" },
              "tier": { "aggregations": [], "operation": "groupby" },
              "owner": { "aggregations": [], "operation": "groupby" },
              "runbook_url": { "aggregations": [], "operation": "groupby" },
              "Value": { "aggregations": ["lastNotNull"], "operation": "aggregate" }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "slo_name": 0,
              "tier": 1,
              "owner": 2,
              "runbook_url": 3,
              "Value (lastNotNull)": 4
            },
            "renameByName": {
              "Value (lastNotNull)": "Burn Rate"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["lexigram", "monitoring", "slo"],
  "templating": {
    "list": [
      {
        "current": { "text": "Default", "value": "default" },
        "hide": 0,
        "includeAll": true,
        "multiValue": true,
        "name": "slo_name",
        "options": [],
        "query": {
          "query": "label_values(lexigram_slo_info, slo_name)",
          "refId": "Prometheus-slo_name-Variable-Query"
        },
        "refresh": 1,
        "regex": "",
        "type": "query"
      },
      {
        "current": { "text": "Default", "value": "default" },
        "hide": 0,
        "includeAll": true,
        "multiValue": true,
        "name": "tier",
        "options": [],
        "query": {
          "query": "label_values(lexigram_slo_info, tier)",
          "refId": "Prometheus-tier-Variable-Query"
        },
        "refresh": 1,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Lexigram / Projection Health",
  "uid": "lexigram-projection-health",
  "version": 1,
  "weekStart": ""
}
